@using Online_Store.ViewModel.HomePage
@model HomePageVM

@{
    ViewBag.Title = "خانه";
}

<!-- Banner -->
<div class="w-full h-[400px] lg:mt-[155px] mt-[132px]">

    <div class="lg:w-[1270px] w-full h-full m-auto mt-8 rounded-3xl relative overflow-hidden">

        <img src="./img/251.png" alt="" class="w-full h-auto rounded-3xl" id="carusel-img" />

        <button id="next-btn" class="absolute lg:right-5 lg:top-1/2 right-3 top-7 slide-next">
            <svg class="w-10 h-10" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                 stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>

        </button>

        <button id="prev-btn" class="absolute lg:left-5 lg:top-1/2 left-3 top-7 slide-prev">
            <svg class="w-10 h-10" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                 stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>
        </button>

    </div>

</div>



