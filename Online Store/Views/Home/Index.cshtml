                    <div class="w-9 h-9 persian-number bg-[#abc5f9] text-[#054ad0] font-sahel flex items-center justify-center rounded-sm text-lg">
                        12
                    </div> :
                    <div class="w-9 h-9 persian-number bg-[#abcff9] text-[#054ad0] flex items-center font-sahel justify-center rounded-sm text-lg">
                        25
                    </div> :
                    <div class="w-9 h-9 persian-number bg-[#abcff9] text-[#054ad0] flex items-center font-sahel justify-center rounded-sm text-lg">
                        02
                    </div>
                </div>
            </div>

            <p class="flex items-center gap-[5px] text-[#054ad0] font-sahel mt-[6.5px]">
                مشاهده همه
