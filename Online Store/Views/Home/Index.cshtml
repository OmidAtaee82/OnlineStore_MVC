                     stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
                </svg>
            </p>

        </div>

        <div class="w-full m-auto mt-5 lg:hidden flex justify-center gap-6">
            <div class="w-9 h-9 persian-number rounded-sm bg-[#abc5f9] text-[#054ad0] font-sahel flex items-center justify-center">12</div>
            :
            <div class="w-9 h-9 persian-number rounded-sm bg-[#abc5f9] text-[#054ad0] font-sahel flex items-center justify-center">25</div>
            :
            <div class="w-9 h-9 persian-number rounded-sm bg-[#abc5f9] text-[#054ad0] font-sahel flex items-center justify-center">02</div>
        </div>


        <div class="w-full m-auto mt-7 lg:grid hidden grid-cols-6 gap-4">

            @foreach(var item in Model.products)
            {

                <a href="#">
                    <div class="border-2 border-gray-200 pr-3 pl-3 pt-4 pb-4 flex flex-col rounded-xl relative">

                        <span class="absolute persian-number top-3 left-2 bg-[#e93638] text-white font-sahel p-2 h-[30px] flex items-center text-sm rounded-md">12%</span>

                        <div class="w-32 h-32 rounded-lg m-auto rounded-xl">
                            <img src="@item.ProductImage" alt="" class="w-full" />
                        </div>

                        <p class="font-yekan mt-3 text-center line-clamp-1 text-[#374151]"> @item.Name</p>

                        <p class="font-sahel persian-number mt-4 text-center text-gray-500 line-through">@item.Discount.Value.ToString("N0")</p>
                        <p class="font-sahel persian-number mt-4 text-center text-[#014edb] text-lg">@item.Price.ToString("N0") تومان</p>

                    </div>
                </a>
            }

        </div>

    </div>

</div>



