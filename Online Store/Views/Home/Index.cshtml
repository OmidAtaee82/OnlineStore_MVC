<!-- Category -->
<div class="w-full mt-14">

    <div class="lg:w-1270 w-[90%] m-auto">

        <div class="w-full m-auto">

            <div class="w-full flex justify-between items-center">
                <p class="font-yekan lg:text-xl text-base">دسته بندی های محبوب</p>
                <a asp-controller="Categories" asp-action="Categories">
                    <p class="flex items-center gap-[5px] text-[#054ad0] font-sahel mt-[6.5px]">
                        مشاهده همه
                        <svg class="w-5 h-5 mt-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
                        </svg>
                    </p>
                </a>
            </div>

            <div class="w-full mt-7 grid lg:grid-cols-7 grid-cols-2 gap-x-4 gap-y-4">

                @foreach(var item in Model.Categories)
                {
                    <a href="category.html">
                        <div class="bg-gray-200 pt-4 pb-4 rounded-2xl">

                            <div class="w-[80%] h-[120px] m-auto flex justify-center items-center rounded-full">
                                <img src="@item.CategoryImage" alt="" class="w-[90%]"/>
                            </div>

                            <p class="text-center mt-4 font-yekan text-[#374151]">@item.Name</p>

                        </div>
                    </a>
                }

            </div>

        </div>

    </div>

</div>



<!-- Amazing offers -->
<div class="w-full mt-14">

    <div class="lg:w-[1270px] w-[90%] m-auto">

