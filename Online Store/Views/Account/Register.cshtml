@using Online_Store.ViewModel.Auth
@model RegisterVM

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewBag.Title = "ثبت نام";
}

<div class="w-[60%] min-h-[600px] flex shadow-login rounded-2xl">

    <div class="lg:w-1/2 bg-white p-6 rounded-tr-2xl rounded-br-2xl">

        <div class="w-full flex items-center gap-2 font-bold text-2xl">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                 stroke="currentColor" class="w-9 h-9 text-[#015cf7]">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>
            <p class="text-[#015cf7]">Omid Store</p>
        </div>

        <div class="w-full m-auto mt-12 text-[#374151] text-lg font-sahel">
            ثبت نام در امید استور
        </div>

        <div class="w-full m-auto mt-4 font-yekan text-[#8f98a7]">
            با چند قدم ساده عضو خانواده بزرگ ما شوید
        </div>

        <form method="post" asp-action="Register">
            
            <div asp-validation-summary="All" class="text-red-600 font-yekan"></div>

            <label class="w-full m-auto mt-10 block font-yekan text-[#374151]">
                نام و نام خانوادگی
            </label>

            <div class="w-full h-11 border-2 border-gray-200 rounded-lg m-auto mt-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                     stroke="currentColor" class="w-8 h-8 mr-4 text-[#374151]">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                </svg>

                <input asp-for="FullName" class="h-full w-full border-none outline-none font-yekan"
                       placeholder=" امید عطایی" />

            </div>


            <label class="w-full m-auto mt-5 block font-yekan text-[#374151]">
                ایمیل
            </label>

            <div class="w-full h-11 m-auto mt-4 flex items-center gap-2 border-2 border-gray-200 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                     stroke="currentColor" class="w-8 h-8 mr-4 text-[#374151]">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z" />
                </svg>

                <input asp-for="Email" class="h-full w-full border-none outline-none font-yekan"
                       placeholder="omidataei1382@gmail.com" />

            </div>


            <label class="w-full m-auto mt-5 block font-yekan text-[#374151]">
                پسورد
            </label>

            <div class="w-full h-11 m-auto mt-4 flex items-center gap-2 border-2 border-gray-200 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                     stroke="currentColor" class="w-8 h-8 mr-4 text-[#374151]">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z" />
                </svg>

                <input asp-for="Password" class="h-full w-full border-none outline-none font-yekan"
                       placeholder="omid1382" />

            </div>


            <input type="submit" value="ثبت نام" class="w-full bg-[#015cf7] cursor-pointer text-white m-auto p-2 text-center mt-5 font-yekan rounded-md" />

        </form>

        <div class="w-full m-auto mt-5 font-yekan text-center text-[#374151]">
            قبلا ثبت نام کرده اید ؟ <a href="/account/login" class="text-[#015cf7]">وارد شوید </a>
        </div>


    </div>

    <div class="lg:w-1/2 bg-gradient flex items-center pr-6 pl-6 rounded-tl-2xl rounded-bl-2xl">

        <div class="w-full m-auto">

            <div class="w-60 h-60 bg-white m-auto rounded-full flex items-center justify-center">
                <img src="/img/karid-asan.png" alt="" class="w-[90%] h-[90%] object-cover" />
            </div>

            <div class="w-[70%] m-auto mt-7 text-center font-sahel text-xl text-white">
                خریدی آسان و مطمئن
            </div>

            <div class="lg:w-[70%] m-auto mt-5 text-center font-yekan text-white">
                Lorem ipsum dolor sit amet
                consectetur.
            </div>

        </div>

    </div>


</div>