@using Online_Store.ViewModel.Product
@model ProductVM

@{
    ViewBag.Title = "جزئیات محصول";
}


<!-- single-prodict -->
<div class="w-full m-auto lg:mt-[155px] mt-28">

    <div class="lg:w-[1270px] w-[90%] m-auto">

        <div class="w-full m-auto flex items-center gap-4 font-yekan text-[#374151]">

            <a href="#">خانه</a>

            <span>/</span>

            <a href="#">موبایل</a>

            <span>/</span>

            <a href="#">شیائومی</a>

            <span>/</span>

            <a href="#">Redmi Note 15</a>

        </div>


        <div class="w-full m-auto mt-8 grid grid-cols-3 gap-6">

            <div class="bg-white border-2 border-gray-200 p-5 rounded-xl">

                <div class="w-full m-auto pt-5 pb-5 rounded-lg bg-[#eef6fc]">
                    <img src="@Model.ProductImage" alt="" class="w-full" />
                </div>

                <div class="w-full m-auto mt-4 flex justify-between">

                    <div class="w-[80px] h-[75px] rounded-lg m-auto mt-4 bg-[#eef6fc] border-2 border-[#dbebf8]"></div>

                    <div class="w-[80px] h-[75px] rounded-lg m-auto mt-4 bg-[#eef6fc] border-2 border-[#dbebf8]"></div>

                    <div class="w-[80px] h-[75px] rounded-lg m-auto mt-4 bg-[#eef6fc] border-2 border-[#dbebf8]"></div>

                    <div class="w-[80px] h-[75px] rounded-lg m-auto mt-4 bg-[#eef6fc] border-2 border-[#dbebf8]"></div>

                </div>

            </div>

            <div class="p-3 bg-white border-2 border-gray-200 rounded-xl">

                <div class="w-full font-yekan mt-3 text-[#4B5563] text-lg">
                    @Model.Name
                </div>

                <div class="w-full h-1 bg-gray-300 mt-6"></div>

                <div class="w-full font-sahel text-[17px] mt-6 text-[#4B5563]">ویژگی های مشترک تمامی محصولات ما : </div>

                <ul class="mt-4 font-yekan text-[#4B5563]">
                    <li>حافظه 256</li>
                    <li class="mt-4">دوربین با کیفیت</li>
                    <li class="mt-4">رنگ بندی مختلف</li>
                </ul>

                <div class="w-full h-1 bg-gray-300 mt-6"></div>

                <div class="w-full m-auto mt-6">

                    <div class="w-full m-auto font-sahel text-[17px] text-[#4B5563]">رنگ بندی : </div>

                    <div class="w-full flex gap-4 mt-6">
                        <div class="w-9 h-9 bg-red-600 rounded-full"></div>
                        <div class="w-9 h-9 bg-blue-600 rounded-full"></div>
                        <div class="w-9 h-9 bg-black rounded-full"></div>
                        <div class="w-9 h-9 bg-gray-600 rounded-full"></div>
                    </div>

                </div>

                <div class="w-full h-1 bg-gray-300 mt-6"></div>

                <div class="w-full m-auto flex gap-4 mt-9 pr-4 pl-4">

                    <a href="#" class="w-full p-3 bg-[#005be7] text-white text-center font-sahel rounded-md">
                        افزودن به
                        سبد خرید
                    </a>

                </div>

            </div>

            <div class="bg-white p-4 pb-7 rounded-xl border-2 border-gray-200">

                <div class="w-full pt-3 pb-3 pr-3 rounded-lg bg-[#eef6fc] border-2 border-[#dbebf8] m-auto mt-4 flex items-center gap-6">

                    <svg class="w-[50px] h-[50px] text-[#054ad0]" xmlns="http://www.w3.org/2000/svg" fill="none"
                         viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
                    </svg>

                    <div class="font-yekan">
                        <p>ارسال سریع و رایگان</p>
                        <p class="mt-4 text-[15px] text-[#4B5563]">برای سافرش های بالای 500 هزار تومان</p>
                    </div>

                </div>

                <div class="w-full pt-3 pb-3 pr-3 rounded-lg bg-[#eef6fc] border-2 border-[#dbebf8] m-auto mt-4 flex items-center gap-6">

                    <svg class="w-[50px] h-[50px] text-[#054ad0]" xmlns="http://www.w3.org/2000/svg" fill="none"
                         viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
                    </svg>

                    <div class="font-yekan">
                        <p>7 روز ضمانت بازگشت کالا</p>
                        <p class="mt-4 text-[15px] text-[#4B5563]">در صورت عدم رضایت</p>
                    </div>

                </div>

                <div class="w-full pt-3 pb-3 pr-3 rounded-lg bg-[#eef6fc] border-2 border-[#dbebf8] m-auto mt-4 flex items-center gap-6">

                    <svg class="w-[50px] h-[50px] text-[#054ad0]" xmlns="http://www.w3.org/2000/svg" fill="none"
                         viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                    </svg>

                    <div class="font-yekan">
                        <p>پرداخت امن</p>
                        <p class="mt-4 text-[15px] text-[#4B5563]">پرداخت انلاین با امنیت کامل</p>
                    </div>

                </div>


                <div class="w-full border-2 border-gray-200 m-auto mt-6 p-4 font-yekan rounded-xl">

                    <div class="w-full font-sahel text-[#4B5563]">مشخصات کلی</div>

                    <div class="w-full flex justify-between mt-4 text-[#4B5563]">
                        <p>نام محصول</p>
                        <p class="text-[#0649cf]">@Model.Name</p>
                    </div>

                    <hr class="mt-3 text-gray-300" />

                    <div class="w-full flex justify-between mt-4 text-[#4B5563]">
                        <p>دسته بندی</p>
                        <p class="text-[#0649cf]">@Model.CategoryName</p>
                    </div>

                    <hr class="mt-3 text-gray-300" />

                    <div class="w-full flex justify-between mt-4 text-[#4B5563]">
                        <p>تاریخ معرفی محصول </p>
                        <p class="text-[#0649cf]">2024</p>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


