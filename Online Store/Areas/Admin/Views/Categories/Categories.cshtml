@using Online_Store.ViewModel.Categories
@model List<CategoryVM>

@{
    ViewBag.Title = "داشبورد -  نمایش دسته بندی";
}

<div class="w-[80%] absolute right-[20%] top-[12%] pr-10 pl-10 text-white">

    <div class="w-full pt-1 pb-10 mt-10">

        <div class="w-full flex justify-between items-center">
            <div>
                <p class="text-3xl font-sahel">دسته بندی محصولات</p>
                <p class="mt-2 font-yekan text-lg">مشاهده و مدیریت دسته بندی محصولات</p>
            </div>
            <a asp-area="Admin" asp-controller="Categories" asp-action="CategoriesCreate"
               class="bg-blue-300 text-black flex gap-2 font-yekan pr-7 pl-7 pt-3 pb-3 rounded-md">
                <svg style="width: 25px;height: 25px;" xmlns="http://www.w3.org/2000/svg" fill="none"
                     viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                افزودن دسته بندی
            </a>
        </div>

        <div class="mt-7 rounded-md pt-3 pb-3 bg-white text-black">

            <table class="font-yekan w-full text-right">

                <thead>
                    <tr>
                        <th class="border-b border-gray-300 p-3 w-[25%]">ردیف</th>
                        <th class="border-b border-gray-300 p-3 w-[25%]">نام</th>
                        <th class="border-b border-gray-300 p-3 w-[25%]">عکس</th>
                        <th class="border-b border-gray-300 p-3 w-[25%]">دسته</th>
                    </tr>
                </thead>

                <tbody class="text-[#424240]">

                    @{
                        int idRow = 0;
                    }

                    @foreach(var item in Model)
                    {

                        idRow++;

                        <tr>
                            <td class="p-3 border-b border-gray-300 w-[25%]">@idRow</td>
                            <td class="p-3 border-b border-gray-300 w-[25%]">@item.Name</td>
                            <td class="p-3 border-b border-gray-300 w-[25%]">
                                <img src="@item.CategoryImage" alt="" class="w-8 h-8" />
                            </td>
                            <td class="p-3 border-b border-gray-300 w-[25%]">@item.ParentName</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>