@using Online_Store.ViewModel.Product
@model ProductVM

@{
    ViewBag.Title = "داشبورد - نمایش کامل اطلاعات محصول";
}

<div class="w-[80%] absolute right-[20%] top-[12%] pr-10 pl-10 text-white">

    <div class="w-full pt-1 pb-10 mt-10">

        <div class="w-full flex justify-between items-center">
            <div>
                <p class="text-3xl font-sahel">نمایش جزئیات محصول</p>
            </div>
            <a asp-area="Admin" asp-controller="Products" asp-action="Products"
               class="bg-blue-300 text-black flex gap-2 font-yekan pr-7 pl-7 pt-3 pb-3 rounded-md">
                مشاهده محصولات
            </a>
        </div>

        <form>

            <div class="w-full mt-12 font-yekan">

                <div class="grid grid-cols-2 gap-6">

                    <div>
                        <label>نام :</label>
                        <input name="Name" value="@Model.Name" disabled type="text"
                               class="bg-white w-full mt-3 border-none text-black p-2 rounded-md placeholder:text-slate-500"/>
                    </div>

                    <div>
                        <label>دسته بندی : </label>
                        <input name="Name" value="@Model.CategoryName" disabled type="text"
                               class="bg-white w-full mt-3 border-none text-black p-2 rounded-md placeholder:text-slate-500"/>
                    </div>

                    <div>
                        <label>برند : </label>
                        <input name="BrandId" value="@Model.BrandName" disabled type="text"
                               class="bg-white w-full mt-3 border-none text-black p-2 rounded-md placeholder:text-slate-500"/>
                    </div>

                    <div>
                        <label>قیمت :</label>
                        <input name="Price" value="@Model.Price.ToString("0")" disabled type="number"
                               class="bg-white w-full mt-3 border-none text-black p-2 rounded-md placeholder:text-slate-500"/>
                    </div>

                    <div>
                        <label>تخفیف :</label>
                        <input name="Discount" value="@Model.Discount" disabled type="number"
                               class="bg-white w-full mt-3 border-none text-black p-2 rounded-md placeholder:text-slate-500"/>
                    </div>

                    <div>
                        <label>رنگ :</label>
                        <input name="Color" value="@Model.Color" disabled type="text"
                               class="bg-white w-full mt-3 border-none text-black p-2 rounded-md placeholder:text-slate-500"/>
                    </div>

                </div>

                <div class="mt-6">
                    <label>توضیحات</label>
                    <textarea disabled name="Description" class="w-full mt-3 bg-white text-black border-none p-2 rounded-md placeholder:text-slate-500">@Model.Description</textarea>
                </div>

                <div class="mt-6">
                    <label>عکس :</label>
                    <img src="@Model.ProductImage" alt="" class="rounded-md w-20 h-20 mt-3"/>
                </div>

            </div>

        </form>

    </div>

</div>