@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
</head>
<body class="bg-[#0c1269]">

    <div class="w-full flex flex-wrap">

        <div class="w-[20%] border-blue-900 h-screen bg-white fixed top-0 css-scroll">

            <div class="w-full h-20 m-auto flex flex-wrap justify-center items-center">

                <div class="w-full h-45 flex">
                    <img src="/img/logo.png" alt="" class="w-full object-cover" />
                </div>

            </div>

            <div class="w-full h-[0.8px] bg-blue-900"></div>

            <div class="w-[90%] m-auto mt-8">

                <div class="font-sahel text-[15px] text-blue-950">اصلی</div>

                <a href="/admin/dashboard" class="@(controller == "Dashboard" ? "text-blue-100 bg-blue-900" : "text-blue-900 hover:bg-blue-300") h-10 flex items-center mt-4 pr-3 rounded-md">
                    <div class="font-yekan flex gap-3 items-center text-lg">
                        <svg style="width: 26px;height: 26px;" xmlns="http://www.w3.org/2000/svg" fill="none"
                             viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                        </svg>
                        داشبورد
                    </div>
                </a>

                <div class=" font-sahel text-[15px] mt-8 text-blue-950">مدیریت</div>

                <a href="/admin/products"
                   class="h-10 flex items-center mt-4 pr-3 rounded-md @(controller == "Products" ? "text-blue-100 bg-blue-900" : "text-blue-900 hover:bg-blue-300")">
                    <div class="font-yekan flex gap-3 items-center text-lg">
                        <svg style="width: 26px;height: 26px;" xmlns="http://www.w3.org/2000/svg" fill="none"
                             viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
                        </svg>
                        محصولات
                    </div>
                </a>

                <a href="category.html"
                   class="text-blue-900 h-10 flex items-center mt-4 pr-3 rounded-md hover:bg-blue-300">
                    <div class="font-yekan flex gap-3 items-center text-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                             stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
                        </svg>
                        دسته بندی محصولات
                    </div>
                </a>

                <a href="brand.html"
                   class="text-blue-900 h-10 flex items-center mt-4 pr-3 rounded-md hover:bg-blue-300">
                    <div class="font-yekan flex gap-3 items-center text-lg">
                        <svg style="width: 26px;height: 26px;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
                        </svg>
                        برند ها
                    </div>
                </a>

                <a href="order.html"
                   class="text-blue-900 h-10 flex items-center mt-4 pr-3 rounded-md hover:bg-blue-300">
                    <div class="font-yekan flex gap-3 items-center text-lg">
                        <svg style="width: 26px;height: 26px;" xmlns="http://www.w3.org/2000/svg" fill="none"
                             viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                        </svg>
                        سفارشات
                    </div>
                </a>

                <a href="users.html"
                   class="text-blue-900 h-10 flex items-center mt-4 pr-3 rounded-md hover:bg-blue-300">
                    <div class="font-yekan flex gap-3 items-center text-lg">
                        <svg style="width: 26px;height: 26px;" xmlns="http://www.w3.org/2000/svg" fill="none"
                             viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                        </svg>
                        کاربران
                    </div>
                </a>

            </div>

        </div>

        <div class="w-[80%] h-20 bg-white fixed top-0 right-[20%] z-50 flex pr-10 pl-10">

            <div class="w-1/2 flex items-center">
                <div class="w-[80%] border-2 border-blue-900 h-11 flex justify-around items-center rounded-lg">
                    <input type="text"
                           class="w-[80%] border-none outline-none font-yekan text-blue-950 placeholder:text-blue-900"
                           placeholder="جست و در پنل مدیریت ... " />
                    <svg color="#1c398e" style="width: 25px;height: 25px;" xmlns="http://www.w3.org/2000/svg"
                         fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                    </svg>
                </div>
            </div>

            <div class="w-1/2 flex items-center justify-end">

                <div class="w-[35%] cursor-pointer h-11 border-2 border-blue-900 flex gap-2 justify-around items-center relative rounded-md">
                    <div class="w-8 h-8 bg-blue-700 rounded-lg flex items-center justify-center">
                        <img src="/img/omid.png" alt="" class="w-full h-full object-contain" />
                    </div>
                    <div class="flex gap-1 text-blue-900">
                        <p class="font-yekan">امید عطایی</p>
                        <svg style="width: 22px;height: 22px;" xmlns="http://www.w3.org/2000/svg" fill="none"
                             viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mt-1">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                        </svg>
                    </div>

                    <div class="w-60 top-full left-0 bg-blue-600 absolute pb-4 mt-3 rounded-lg hidden">

                        <div class="w-full bg-pink-500 mt-4 font-yekan text-lg pr-4">امید عطایی</div>
                        <div class="w-full bg-pink-400 mt-1 text-sm pr-4">omidataeiyyy1382@gmail.com</div>
                        <hr class="mt-4" />

                        <div class="w-full bg-yellow-400 mt-4 pr-4">

                            <a href="#">
                                <div class="flex items-center gap-2 font-yekan">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                         stroke-width="1.5" stroke="currentColor" class="size-6">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                    </svg>
                                    پروفایل
                                </div>
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        @RenderBody()

    </div>

    <script src="/js/DeleteProduct.js"></script>
</body>
</html>
